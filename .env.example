# Frontend Public Configuration (Vite)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================================================
# Server-Side Vercel Serverless Environment Variables (NEVER expose as VITE_*)
# Configure these in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# Google Gmail SMTP (Use your Gmail address + a 16-character Google App Password)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
GMAIL_FROM_NAME=Nook StudyPlanner

# Optional endpoint security + app links
CRON_SECRET=generate_a_long_random_secret
APP_BASE_URL=https://your-studyplanner-domain.vercel.app

# Supabase Server Access (Used by background notification runner /api/cron/notifications)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-Side Voice AI (Optional - enables secure server-side Gemini & OpenAI Realtime WebRTC)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
